# --- Supabase (EU region). Leave empty to run in in-memory demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs Agents (voice). Leave empty: the senior screen shows a friendly "voice not configured" state. ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Optional, only read by `node scripts/elevenlabs/setup-agent.mjs` (see docs/elevenlabs-agent.md):
# ELEVENLABS_LLM=gemini-2.5-flash
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_ID_IT=
# ELEVENLABS_POST_CALL_WEBHOOK_ID=

# --- Twilio (SMS + optional voice call to relatives). Leave empty for demo mode. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Resend (email fallback in demo mode). Optional. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: real phone numbers for the seeded relatives (E.164), used by the seed script / in-memory seed.
SEED_RELATIVE_ANNA_PHONE=
SEED_RELATIVE_THOMAS_PHONE=
SEED_FALLBACK_PHONE=

# --- Escalation ladder cron (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"). Required in production. ---
CRON_SECRET=
